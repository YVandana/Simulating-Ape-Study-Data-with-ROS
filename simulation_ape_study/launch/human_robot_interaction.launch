<launch>
  <group ns="cr_week6_test">
    <node pkg = "cr_week6_test" name = "Generator" type = "interaction_generator.py" output = "screen"></node>
    <node pkg = "cr_week6_test" name = "Filter" type = "perception_filter.py" output = "screen"></node>
    <node pkg = "cr_week6_test" name = "Controller" type = "robot_controller.py" output = "screen"></node>
    <node pkg = "cr_week6_test" name = "Predictor" type = "robot_expression_prediction.py" output = "screen"></node>
  </group>
</launch>
